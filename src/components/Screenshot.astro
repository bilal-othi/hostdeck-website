---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * A screenshot of the app in light and dark appearance (the visitor's setting picks one), converted to WebP at 1× and
 * 2× sizes. The sources come from the app repository's scripts/make-website-screenshots.sh (lossless WebP), or the
 * older PNGs of scripts/make-screenshots.sh. With `zoom` (the default) it's a button that opens the full-size picture.
 */
interface Props {
  /** File name without "-light" / "-dark" and the extension */
  name: string;
  alt: string;
  /** Width on the page in CSS pixels */
  width: number;
  class?: string;
  /** Load at once (the first screen), not when scrolled to */
  eager?: boolean;
  /** Click to see it full size */
  zoom?: boolean;
}

const { name, alt, width, class: className, eager = false, zoom = true } = Astro.props;
const files = import.meta.glob<{ default: ImageMetadata }>('../assets/screenshots/*.{png,webp}', { eager: true });

function file(appearance: 'light' | 'dark'): ImageMetadata {
  const found = files[`../assets/screenshots/${name}-${appearance}.webp`] ?? files[`../assets/screenshots/${name}-${appearance}.png`];
  if (!found) throw new Error(`Missing screenshot ${name}-${appearance}`);
  return found.default;
}

const light = file('light');
const dark = file('dark');
const height = Math.round((light.height / light.width) * width);
const widths = [width, Math.min(width * 2, light.width)];
const sizes = `(max-width: ${width + 40}px) calc(100vw - 40px), ${width}px`;
const [lightImage, darkImage] = await Promise.all(
  // `width` too, so the plain src (for browsers without srcset) is the 1× size, not the original
  [light, dark].map((src) => getImage({ src, width, widths, format: 'webp', quality: 86 })),
);
const full = zoom
  ? await Promise.all([light, dark].map((src) => getImage({ src, width: Math.min(src.width, 2440), format: 'webp', quality: 90 })))
  : null;
---

{
  full ? (
    <button
      type="button"
      class:list={['shot', className]}
      data-zoom
      data-light={full[0].src}
      data-dark={full[1].src}
      data-alt={alt}
      data-ratio={(light.width / light.height).toFixed(4)}
    >
      <picture>
        <source media="(prefers-color-scheme: dark)" srcset={darkImage.srcSet.attribute} sizes={sizes} type="image/webp" />
        <img
          src={lightImage.src}
          srcset={lightImage.srcSet.attribute}
          sizes={sizes}
          width={width}
          height={height}
          alt={alt}
          loading={eager ? 'eager' : 'lazy'}
          fetchpriority={eager ? 'high' : undefined}
          decoding="async"
        />
      </picture>
      <span class="shot-zoom" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7" /></svg>
      </span>
      <span class="visually-hidden">Enlarge</span>
    </button>
  ) : (
    <picture class={className}>
      <source media="(prefers-color-scheme: dark)" srcset={darkImage.srcSet.attribute} sizes={sizes} type="image/webp" />
      <img
        src={lightImage.src}
        srcset={lightImage.srcSet.attribute}
        sizes={sizes}
        width={width}
        height={height}
        alt={alt}
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : undefined}
        decoding="async"
      />
    </picture>
  )
}
