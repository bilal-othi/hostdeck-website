---
/** HostDeck's menu bar icon (a deck of three cards, a terminal prompt on the front one), as in the app. */
interface Props {
  size?: number;
}
const { size = 18 } = Astro.props;
const id = `cascade-${Math.random().toString(36).slice(2, 8)}`;
---

<svg width={size} height={size} viewBox="0 0 18 18" aria-hidden="true">
  <defs>
    <mask id={`${id}-back`}>
      <rect width="18" height="18" fill="white" />
      <rect x="2.6" y="3.6" width="12.8" height="11" rx="2.9" fill="black" />
    </mask>
    <mask id={`${id}-middle`}>
      <rect width="18" height="18" fill="white" />
      <rect x="0" y="6.8" width="12.8" height="11" rx="2.9" fill="black" />
    </mask>
    <mask id={`${id}-front`}>
      <rect width="18" height="18" fill="white" />
      <path d="M3.3 10.4 6.5 12.4 3.3 14.4" fill="none" stroke="black" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
      <rect x="8.1" y="13.65" width="2.8" height="1.5" rx="0.75" fill="black" />
    </mask>
  </defs>
  <g fill="currentColor">
    <rect x="6.2" y="1.4" width="10.8" height="9" rx="2.2" mask={`url(#${id}-back)`} />
    <rect x="3.6" y="4.6" width="10.8" height="9" rx="2.2" mask={`url(#${id}-middle)`} />
    <rect x="1" y="7.8" width="10.8" height="9" rx="2.2" mask={`url(#${id}-front)`} />
  </g>
</svg>
